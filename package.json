{
  "name": "libresound_js_libs",
  "version": "0.6.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "watch": "rollup -c -w",
    "build": "rollup -c",
    "clean": "rm -r dist",
    "build_doc": "npx typedoc --plugin 'typedoc-material-theme' --customCss './src/style.css' --out documentation --favicon $LS_PLUGINS_REPO/public/images/favicon.png src/MusicPlayer/*.ts",
    "copy_doc": "cp -r documentation $LS_PLUGINS_REPO/public/",
    "doc": "npm run build_doc && npm run copy_doc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motobep/libresound_js_libs.git"
  },
  "keywords": [
    "libresound",
    "API",
    "javascript"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "package.json",
    "package-lock.json",
    "rollup.config.js",
    "tsconfig.json",
    "src/MusicPlayer/"
  ],
  "author": "motobep",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/motobep/libresound_js_libs/issues"
  },
  "homepage": "https://github.com/motobep/libresound_js_libs#readme",
  "description": "",
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.1.2",
    "dotenv": "^17.2.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.14",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "formdata-polyfill": "^4.0.10",
    "headers-polyfill": "^4.0.3",
    "text-encoding-shim": "^1.0.5",
    "web-streams-polyfill": "^4.2.0",
    "whatwg-fetch": "^3.6.20",
    "whatwg-url": "^15.1.0",
    "zod": "^4.1.12"
  }
}
